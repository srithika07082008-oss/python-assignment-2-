def subsidy_separate_if(units):
    # BUGGY on purpose: each slab test is independent and the result accumulates
    subsidy = 0
    if units <= 100:
        subsidy += 100
    if units <= 200:
        subsidy += 50      # a 80-unit house ALSO passes this test
    if units <= 500:
        subsidy += 25      # ...and this one
    return subsidy


def subsidy_elif(units):
    # CORRECT: mutually exclusive branches, chained comparisons, first match wins
    if 0 <= units <= 100:
        return 100
    elif 101 <= units <= 200:
        return 50
    elif 201 <= units <= 500:
        return 25
    elif units > 500:
        return 0
    else:
        raise ValueError('units cannot be negative')


households = [50, 100, 101, 150, 200, 201, 350, 501]
print('Units | separate-if | if-elif')
for u in households:
    print(f'{u:5} | {subsidy_separate_if(u):11} | {subsidy_elif(u):7}')
